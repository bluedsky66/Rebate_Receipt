{
    "store_id": "walmart",
    "page_width_dots": 384,
    "line_height": 30,
    "char_spacing": 0,
    "header": {
        "alignment": "center",
        "show_name": true,
        "show_address": true,
        "address_template": "123 MAIN ST\nCITY, STATE 12345"
    },
    "item_line": {
        "name_align": "left",
        "price_align": "right",
        "price_offset": 0,
        "qty_template": "{qty} @ {unit_price}",
        "show_upc": true
    },
    "tax_line_format": {
        "mode": "single",
        "single_label": "TAX",
        "split_labels": [
            "STATE TAX",
            "LOCAL TAX"
        ],
        "show_rate": true,
        "alignment": "right",
        "separator": " "
    },
    "payment_line": {
        "label": "TENDER",
        "alignment": "right",
        "mask_format": "{type} ****{last4}",
        "cash_label": "CASH",
        "store_specific": {
            "walmart_pay": true,
            "walmart_pay_threshold": "100.00",
            "costco_visa_only": false
        }
    },
    "total_section": {
        "subtotal_label": "SUBTOTAL",
        "tax_label": "TAX",
        "total_label": "TOTAL",
        "separator": "--------------------------------"
    },
    "footer": {
        "barcode_type": "CODE39",
        "terminal_id_format": "TERM {register}",
        "txn_format": "TC# {store_id} {register} {seq} {timestamp}",
        "show_time": true,
        "time_format": "%m/%d/%Y %H:%M:%S"
    },
    "custom_escpos": [
        "\u001b@",
        "\u001ba\u0001"
    ]
}